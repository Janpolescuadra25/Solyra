# Backend Solyra Config
PORT=4000

# PostgreSQL Connection (use either DATABASE_URL or individual PG* variables)
DATABASE_URL=postgresql://solyra_user:password@localhost:5432/solyra_db

# Alternative connection settings:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=Solyra_db

# JWT Secret for Session Tokens
JWT_SECRET=solyra-dev-jwt-secret-do-not-use-in-production-change-me

# Brain package signature enforcement
BRAIN_ENFORCE_SIGNATURES=false
BRAIN_TRUSTED_AUTHOR_KEYS=
