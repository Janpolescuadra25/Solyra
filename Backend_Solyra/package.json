{
  "name": "@solyra/backend",
  "version": "0.1.0",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:step8": "tsx --test test/step8_acceptance_matrix.test.ts",
    "benchmark:step9.5": "tsx --test test/step9.5_scalability_benchmark.test.ts",
    "test:step9.5": "tsx --test test/step9.5_scalability_benchmark.test.ts",
    "db:seed": "tsx src/persistence/postgres/seed.ts",
    "test:brainstem": "tsx ./test/brainstem.verify.ts",
    "test:persistence": "tsx ./test/persistence.verify.ts",
    "test:integration:pg": "tsx test/postgres.verify.ts",
    "test:postgres": "tsx ./src/persistence/postgres/postgres.verify.ts",
    "test:step9.4": "tsx --test test/step9.4_storage_acceptance_matrix.test.ts"
  },
  "dependencies": {
    "@solyra/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
