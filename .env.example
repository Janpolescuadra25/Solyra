# ============================================================================== 
# Solyra Global Configuration Template
# METADATA ONLY - ZERO SECRETS IN REPOSITORY
# Copy this file to .env and configure local variables.
# ==============================================================================

NODE_ENV=development
SOLYRA_PORT=3000
BACKEND_PORT=4000

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql://solyra_user:your_password@localhost:5432/solyra_db

# Homeostasis & Brainstem Limits
SOL_MAX_RAM_MB=2048
SOL_MAX_WORKING_MEMORY_SLOTS=7
SOL_HOMEOSTASIS_PRESSURE_THRESHOLD=0.80

# Logging
LOG_LEVEL=info